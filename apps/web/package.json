    "test:editor:e2e": "playwright test -c tools/guitar-editor/playwright.config.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "gray-matter": "^4.0.3",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-snowfall": "^2.4.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.3",
    "vite": "^8.2.0"
  }
