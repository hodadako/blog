{
  "name": "blog",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "guitar:editor": "pnpm --filter web guitar:editor",
    "guitar:editor:typecheck": "pnpm --filter web guitar:editor:typecheck",
    "guitar:editor:test:e2e": "pnpm --filter web test:editor:e2e",
    "test": "pnpm --filter web test && pnpm --dir infra/cloudflare-worker test",
    "prepare": "husky",
    "lint": "pnpm --filter web lint",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "pnpm --filter web build-storybook",
    "test:storybook": "pnpm --filter web test:storybook",
    "test:visual": "pnpm --filter web test:visual"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.17.1",
  "volta": {
    "node": "24.18.0"
  }
}
